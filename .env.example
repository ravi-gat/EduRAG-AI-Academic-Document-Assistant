# EduRAG Local Environment Configuration Example
# Copy this file to .env and insert your personal Google Gemini API key.

# Google Gemini API Key (Required for live answer synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g., gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Default retrieval calibration threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.35
